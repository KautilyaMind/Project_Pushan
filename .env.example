# Copy this file to .env and fill values locally. Never commit .env.
PUSHAN_ENV=development
PUSHAN_API_HOST=127.0.0.1
PUSHAN_API_PORT=8000
PUSHAN_DATABASE_PATH=data/pushan.db
# Optional production database. When set, this overrides PUSHAN_DATABASE_PATH.
DATABASE_URL=
PUSHAN_MODEL_PATH=artifacts/irrigation_model.joblib
PUSHAN_VECTOR_STORE_PATH=artifacts/vector_store
GOOGLE_API_KEY=
PUSHAN_LLM_MODEL=gemini-3.1-flash-lite
PUSHAN_EMBEDDING_MODEL=local-hash-v1
PUSHAN_API_URL=http://127.0.0.1:8000
MAX_AUTO_APPROVED_WATER_LITRES=5000
PUSHAN_AUTOMATION_WEBHOOK_URL=
PUSHAN_WEBHOOK_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
